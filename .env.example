# Runtime
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://yourdomain.com

# Необязательно: максимум миллисекунд на graceful shutdown (SIGTERM/SIGINT)
# перед принудительным завершением. По умолчанию 15000.
# SHUTDOWN_TIMEOUT_MS=15000

# Необязательно: docker-compose.yaml читает эту переменную (Compose-синтаксис
# длительности - "20s", не миллисекунды) для stop_grace_period контейнера -
# сколько Docker ждёт после docker stop, прежде чем прислать SIGKILL. Должен
# быть больше SHUTDOWN_TIMEOUT_MS выше (с запасом), иначе Docker убьёт
# процесс раньше, чем graceful shutdown успеет завершиться сам. По умолчанию
# 20s соответствует SHUTDOWN_TIMEOUT_MS по умолчанию (15000мс).
# STOP_GRACE_PERIOD=20s

# Database Configuration
DB_USER=admin
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432
DB_NAME=pixelbattle

# Admin Configuration
ADMIN_PASSWORD=your_admin_panel_password
SESSION_SECRET=replace_with_a_random_long_value
