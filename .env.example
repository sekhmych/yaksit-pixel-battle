# Runtime
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://yourdomain.com

# Необязательно: максимум миллисекунд на graceful shutdown (SIGTERM/SIGINT)
# перед принудительным завершением. По умолчанию 15000.
# SHUTDOWN_TIMEOUT_MS=15000

# Database Configuration
DB_USER=admin
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=5432
DB_NAME=pixelbattle

# Admin Configuration
ADMIN_PASSWORD=your_admin_panel_password
SESSION_SECRET=replace_with_a_random_long_value
